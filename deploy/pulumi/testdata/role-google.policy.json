{
  "Statement": [
    {
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:logs:r1:111122223333:log-group:/aws/lambda/google:*",
      "Sid": "SluisLogs"
    },
    {
      "Action": "sqs:SendMessage",
      "Effect": "Allow",
      "Resource": "arn:aws:sqs:r1:111122223333:acme-audit",
      "Sid": "SluisAuditIngest"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParameterHistory",
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/google/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/google/*"
      ],
      "Sid": "SluisParametersGoogle"
    },
    {
      "Action": [
        "ssm:GetParametersByPath"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/google",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/google"
      ],
      "Sid": "SluisParametersListGoogle"
    },
    {
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Condition": {
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": [
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/google/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/google/*"
          ],
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/shared",
      "Sid": "SluisParameterKey"
    },
    {
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-google",
      "Sid": "SluisTableGoogle"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-blobs/google/*",
      "Sid": "SluisGoogleBlobs"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "google/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-blobs",
      "Sid": "SluisGoogleBlobList"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/oidc/signin/*"
      ],
      "Sid": "SluisSignInClient"
    },
    {
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:TransactWriteItems"
      ],
      "Condition": {
        "ForAnyValue:StringEquals": {
          "dynamodb:LeadingKeys": [
            "maintenance"
          ]
        }
      },
      "Effect": "Deny",
      "Resource": "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-google",
      "Sid": "SluisMaintenanceDeny"
    },
    {
      "Action": [
        "kms:Decrypt"
      ],
      "Condition": {
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": [
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/oidc/signin/*"
          ],
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/shared",
      "Sid": "SluisParameterKeyCross"
    },
    {
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Condition": {
        "StringLike": {
          "kms:ViaService": "dynamodb.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/tables",
      "Sid": "SluisStateKey"
    }
  ],
  "Version": "2012-10-17"
}
