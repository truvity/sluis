{
  "Statement": [
    {
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:logs:r1:111122223333:log-group:/aws/lambda/restore:*",
      "Sid": "SluisLogs"
    },
    {
      "Action": "sqs:SendMessage",
      "Effect": "Allow",
      "Resource": "arn:aws:sqs:r1:111122223333:acme-audit",
      "Sid": "SluisAuditIngest"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParameterHistory",
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/backup/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/backup/*"
      ],
      "Sid": "SluisParametersBackup"
    },
    {
      "Action": [
        "ssm:GetParametersByPath"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/backup",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/backup"
      ],
      "Sid": "SluisParametersListBackup"
    },
    {
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey"
      ],
      "Condition": {
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": [
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/backup/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/backup/*"
          ],
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/shared",
      "Sid": "SluisParameterKey"
    },
    {
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-backup",
      "Sid": "SluisTableBackup"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-blobs/backup/*",
      "Sid": "SluisBackupBlobs"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "backup/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-blobs",
      "Sid": "SluisBackupBlobList"
    },
    {
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-cloudflare",
        "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-github",
        "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-google",
        "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-oidc",
        "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-outline",
        "arn:aws:dynamodb:r1:111122223333:table/sluis-i1-slack"
      ],
      "Sid": "SluisCrossTable"
    },
    {
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParameterHistory",
        "ssm:PutParameter",
        "ssm:DeleteParameter"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/cloudflare/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/cloudflare/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/github/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/github/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/google/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/google/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/oidc/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/oidc/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/outline/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/outline/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/slack/*",
        "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/slack/*"
      ],
      "Sid": "SluisCrossParameters"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Effect": "Allow",
      "Resource": [
        "arn:aws:s3:::acme-blobs/cloudflare/*",
        "arn:aws:s3:::acme-blobs/github/*",
        "arn:aws:s3:::acme-blobs/google/*",
        "arn:aws:s3:::acme-blobs/oidc/*",
        "arn:aws:s3:::acme-blobs/outline/*",
        "arn:aws:s3:::acme-blobs/slack/*"
      ],
      "Sid": "SluisCrossBlobs"
    },
    {
      "Action": "s3:ListBucket",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "cloudflare/*",
            "github/*",
            "google/*",
            "oidc/*",
            "outline/*",
            "slack/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-blobs",
      "Sid": "SluisCrossBlobList"
    },
    {
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Condition": {
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": [
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/cloudflare/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/cloudflare/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/github/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/github/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/google/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/google/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/oidc/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/oidc/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/outline/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/outline/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/slack/*",
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/external/slack/*"
          ],
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/shared",
      "Sid": "SluisParameterKeyCross"
    },
    {
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Condition": {
        "StringLike": {
          "kms:ViaService": "dynamodb.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/tables",
      "Sid": "SluisStateKey"
    },
    {
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-archive/pre/backup/i1/*",
      "Sid": "SluisArchiveObjects"
    },
    {
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "pre/backup/i1/*"
          ]
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:s3:::acme-archive",
      "Sid": "SluisArchiveList"
    },
    {
      "Action": [
        "ssm:GetParameter"
      ],
      "Effect": "Allow",
      "Resource": "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/backup/restore-identity",
      "Sid": "SluisRestoreIdentity"
    },
    {
      "Action": [
        "kms:Decrypt"
      ],
      "Condition": {
        "StringLike": {
          "kms:EncryptionContext:PARAMETER_ARN": [
            "arn:aws:ssm:r1:111122223333:parameter/sluis/i1/internal/backup/restore-identity"
          ],
          "kms:ViaService": "ssm.*.amazonaws.com"
        }
      },
      "Effect": "Allow",
      "Resource": "arn:aws:kms:r1:111122223333:key/shared",
      "Sid": "SluisRestoreIdentityKey"
    },
    {
      "Action": "lambda:InvokeFunction",
      "Effect": "Allow",
      "Resource": [
        "arn:aws:lambda:r1:111122223333:function:sluis-i1-restore:live-console"
      ],
      "Sid": "SluisRestoreSelf"
    }
  ],
  "Version": "2012-10-17"
}
