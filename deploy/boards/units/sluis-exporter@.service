# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis exporter (%i)
Documentation=https://sluis.id/runtimes/bare-metal/
Requires=sluis-drv-exporter-dir@%i.service
After=sluis-drv-exporter-dir@%i.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=sluis-exporter-%i
Group=sluis-exporter-%i
SupplementaryGroups=sluis-drv-exporter-dir-%i sluis-drv-writer-spool-%i sluis-key-%i sluis-policy-%i sluis-store-%i sluis-keyc-013-%i
ExecStart=/opt/sluis/bin/actors/exporter serve --boundary %i
Restart=on-failure
RestartSec=2s
RestartSteps=5
RestartMaxDelaySec=30

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SocketBindDeny=any
NoExecPaths=-/opt/sluis/bin/drivers -/run/sluis/exporter -/tmp -/var/tmp -/dev/shm
ReadWritePaths=/run/sluis/exporter

[Install]
WantedBy=multi-user.target
