# Generated by tools/gen/units from the registries (docs/architecture/*.yaml, tools/gen/registry/uids.yaml).
# Do not edit: run `just units-gen`.
[Unit]
Description=sluis driver exporter-dir (%i)
Documentation=https://sluis.id/runtimes/bare-metal/

[Service]
Type=simple
User=sluis-drv-exporter-dir-%i
Group=sluis-drv-exporter-dir-%i
SupplementaryGroups=sluis-exporter-drv-%i
StateDirectory=sluis-state/%i/drv-exporter-dir sluis-state/%i/exporter-public
StateDirectoryMode=0755
ExecStart=/opt/sluis/bin/drivers/exporter/dir serve --boundary %i --socket /run/sluis/exporter/%i/directory.sock --root /var/lib/sluis-state/%i/exporter-public --state-dir /var/lib/sluis-state/%i/drv-exporter-dir --socket-gid 61031
Restart=on-failure
RestartSec=2s

# Hardening (ADR 0003)
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
SocketBindDeny=any
ReadWritePaths=/run/sluis/exporter/%i

[Install]
WantedBy=multi-user.target
