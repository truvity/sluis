{
  "$defs": {
    "duration": {
      "description": "A Go duration: 30s, 2m, 168h.",
      "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|µs|ms|s|m|h))+$",
      "type": "string"
    },
    "url": {
      "allOf": [
        {
          "pattern": "^https?://\\S+$"
        },
        {
          "not": {
            "pattern": "^https?://[^/?#\\s]*@"
          }
        }
      ],
      "description": "An http or https URL with a host and no credentials: a password in a URL is a secret in the file, and a secret is named, never carried.",
      "minLength": 1,
      "type": "string"
    }
  },
  "$id": "https://truvity.github.io/sluis/schemas/v2/config/policy.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "The policy document: what an installation decides, read by every process of it. The access model's tables (docs/reference/policy.md) and beside them whom the exchange trusts, what an operator may make, what each controller may change and what is copied out. Rendered by `sluisctl policy render` from layers; a process reads exactly one. Nothing here is a secret.",
  "properties": {
    "apiVersion": {
      "const": "sluis.truvity.github.io/policy/v2",
      "description": "Which version of which document this is. sluis.truvity.github.io/policy/v2 is what this build writes; a document with no apiVersion is v1, which the binary converts as it loads it, and a binary reads v2 and v1 (docs/reference/configuration.md)."
    },
    "apps": {
      "additionalProperties": false,
      "description": "What an operator may make on the console.",
      "properties": {
        "github": {
          "additionalProperties": false,
          "description": "GitHub Apps.",
          "properties": {
            "catalogue": {
              "description": "Every GitHub App the installation declares (docs/how-to/connect/github-apps-catalogue.md). A grant naming an undeclared group stops the service.",
              "items": {
                "additionalProperties": false,
                "description": "One App: created under `org` from the console, and installed there.",
                "properties": {
                  "description": {
                    "description": "What it is for.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "events": {
                    "description": "Webhook events; the webhook stays inactive.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "type": "array"
                  },
                  "export": {
                    "description": "Place the installed App's key at `external/github/<id>` for a consumer to read (secrets layout v4). Unset keeps it internal. An id may not begin `runner-`.",
                    "type": "boolean"
                  },
                  "grants": {
                    "description": "Who may ask for tokens of it, and for how much.",
                    "items": {
                      "additionalProperties": false,
                      "description": "A grant.",
                      "properties": {
                        "group": {
                          "description": "The internal group.",
                          "minLength": 1,
                          "type": "string"
                        },
                        "permissions": {
                          "additionalProperties": {
                            "enum": [
                              "read",
                              "write",
                              "admin"
                            ]
                          },
                          "description": "Permission name to level: read, write or admin.",
                          "minProperties": 1,
                          "type": "object"
                        },
                        "repositories": {
                          "description": "Repository globs.",
                          "items": {
                            "minLength": 1,
                            "type": "string"
                          },
                          "minItems": 1,
                          "type": "array"
                        }
                      },
                      "required": [
                        "group",
                        "repositories",
                        "permissions"
                      ],
                      "type": "object"
                    },
                    "type": "array"
                  },
                  "id": {
                    "description": "[a-z0-9-], at most 32, unique; never changes.",
                    "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                    "type": "string"
                  },
                  "installation": {
                    "description": "all or selected (default).",
                    "enum": [
                      "all",
                      "selected"
                    ]
                  },
                  "name": {
                    "description": "Default <org>-<id>.",
                    "maxLength": 34,
                    "minLength": 1,
                    "type": "string"
                  },
                  "org": {
                    "description": "The organisation it is created under.",
                    "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9]){0,38}$",
                    "type": "string"
                  },
                  "permissions": {
                    "additionalProperties": {
                      "enum": [
                        "read",
                        "write",
                        "admin"
                      ]
                    },
                    "description": "Permission name to level: read, write or admin.",
                    "minProperties": 1,
                    "type": "object"
                  },
                  "public": {
                    "description": "Installable by other organisations.",
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "org",
                  "permissions"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "runnerTiers": {
              "description": "The tiers an operator may create a runner App for: lower-case letters, digits and dashes, at most 16, each once.",
              "items": {
                "pattern": "^[a-z0-9]([a-z0-9-]{0,14}[a-z0-9])?$",
                "type": "string"
              },
              "type": "array",
              "uniqueItems": true
            }
          },
          "type": "object"
        },
        "slack": {
          "additionalProperties": false,
          "description": "Slack Apps.",
          "properties": {
            "catalogue": {
              "description": "Every Slack App the installation declares (docs/how-to/connect/slack-apps-catalogue.md). One for a workspace the policy does not declare stops the service.",
              "items": {
                "additionalProperties": false,
                "description": "One Slack App, created and installed from the console.",
                "properties": {
                  "botScopes": {
                    "description": "The bot scopes.",
                    "items": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "minItems": 1,
                    "type": "array"
                  },
                  "description": {
                    "description": "At most 140.",
                    "maxLength": 140,
                    "minLength": 1,
                    "type": "string"
                  },
                  "id": {
                    "description": "[a-z0-9-], at most 32, unique; never changes.",
                    "pattern": "^[a-z0-9]([a-z0-9-]{0,30}[a-z0-9])?$",
                    "type": "string"
                  },
                  "name": {
                    "description": "Default <workspace>-<id>.",
                    "maxLength": 35,
                    "minLength": 1,
                    "type": "string"
                  },
                  "workspace": {
                    "description": "A key of the policy's slack.workspaces.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "workspace",
                  "botScopes"
                ],
                "type": "object"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "claims": {
      "additionalProperties": {
        "description": "A claims fragment: merged into the token (docs/reference/policy.md#claims).",
        "type": "object"
      },
      "description": "What a group adds to a token, by group.",
      "type": "object"
    },
    "client_documents": {
      "additionalProperties": false,
      "description": "Admits clients that are not declared, by a document they serve about themselves. Off unless it names an origin.",
      "properties": {
        "groups": {
          "description": "Which held groups beyond the requires pairs a token for it carries: `all`, or a list of things, families or names (docs/reference/policy.md#groups-in-a-token-scoping).",
          "oneOf": [
            {
              "const": "all"
            },
            {
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          ]
        },
        "origins": {
          "description": "The origins.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "requires": {
          "description": "The groups a caller must hold.",
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "session": {
          "default": "interactive",
          "description": "Every document client's refresh chains: `interactive` (a person at a browser, the installation's `lifetimes`) or `agent` (software that holds its refresh token and works in the background, the service's `lifetimes.agent`). Recorded on each chain when its authorization completes (docs/decisions/0040). Never read from a document: admit with `agent` only an origin whose documents its vendor controls.",
          "enum": [
            "interactive",
            "agent"
          ]
        },
        "ttl_cap": {
          "$ref": "#/$defs/duration",
          "description": "The longest a token lives."
        }
      },
      "type": "object"
    },
    "clients": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "A client: who may be issued a token, and for what. Its id is the audience.",
        "properties": {
          "backchannel_logout_uri": {
            "description": "Where a back-channel logout is posted.",
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "description": "One line about it on the sign-in page. Public.",
            "minLength": 1,
            "type": "string"
          },
          "display_name": {
            "description": "What the sign-in page calls it. Public.",
            "minLength": 1,
            "type": "string"
          },
          "groups": {
            "description": "Which held groups beyond the requires pairs a token for it carries: `all`, or a list of things, families or names (docs/reference/policy.md#groups-in-a-token-scoping).",
            "oneOf": [
              {
                "const": "all"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "groups_delimiter": {
            "description": "Rewrites `:` in its `groups` claim (docs/decisions/0015).",
            "minLength": 1,
            "type": "string"
          },
          "kind": {
            "description": "public, confidential or exchange.",
            "enum": [
              "public",
              "confidential",
              "exchange"
            ]
          },
          "redirects": {
            "description": "The redirect URIs.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "requires": {
            "description": "The groups a caller must hold, any of them.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "secret": {
            "description": "For a confidential client: the name its secret is delivered under, or `{generate: true}` to have the issuer generate it and keep it with its credentials.",
            "oneOf": [
              {
                "minLength": 1,
                "type": "string"
              },
              {
                "additionalProperties": false,
                "description": "The issuer generates the secret.",
                "properties": {
                  "generate": {
                    "const": true,
                    "description": "Must be true; `generate: false` is refused."
                  }
                },
                "required": [
                  "generate"
                ],
                "type": "object"
              }
            ]
          },
          "session": {
            "default": "interactive",
            "description": "Its refresh chains: `interactive` (a person at a browser, the installation's `lifetimes`) or `agent` (software that holds its refresh token and works in the background, the service's `lifetimes.agent`). Recorded on each chain when its authorization completes (docs/decisions/0040). Refused on an exchange client and, as `agent`, with `sign_in_exchange`.",
            "enum": [
              "interactive",
              "agent"
            ]
          },
          "sign_in_exchange": {
            "description": "It may exchange a sign-in for a token of its own.",
            "type": "boolean"
          },
          "signed_out": {
            "description": "Where sign-out may return the browser.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "signing_alg": {
            "description": "The algorithm its tokens are signed with, when it cannot verify the default: RS256, ES256 or ES384.",
            "minLength": 1,
            "type": "string"
          },
          "ttl_cap": {
            "$ref": "#/$defs/duration",
            "description": "The longest a token for it lives."
          }
        },
        "required": [
          "kind"
        ],
        "type": "object"
      },
      "description": "Who may be issued a token, by client id.",
      "type": "object"
    },
    "controllers": {
      "additionalProperties": false,
      "description": "What each controller may CHANGE. Everything else the policy binds is derived every pass and shown with what would happen, and left alone: an organisation or workspace is born disabled.",
      "properties": {
        "github": {
          "additionalProperties": false,
          "description": "The GitHub controller.",
          "properties": {
            "enabledOrgs": {
              "description": "The organisations it changes. Each must be bound by the github table.",
              "items": {
                "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-[A-Za-z0-9])*$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        },
        "slack": {
          "additionalProperties": false,
          "description": "The Slack controller.",
          "properties": {
            "enabledWorkspaces": {
              "description": "The workspaces it changes, by key. Each must be declared by the slack table.",
              "items": {
                "pattern": "^[a-z0-9](?:[a-z0-9-]{0,38}[a-z0-9])?$",
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "exchange": {
      "additionalProperties": false,
      "description": "Whom the token exchange trusts. Nothing here is a secret: every row is a name and a URL.",
      "properties": {
        "aws": {
          "additionalProperties": false,
          "description": "The AWS accounts whose roles' outbound identity tokens (sts:GetWebIdentityToken) are verified. An empty list verifies none.",
          "properties": {
            "accounts": {
              "description": "The accounts.",
              "items": {
                "additionalProperties": false,
                "description": "An account.",
                "properties": {
                  "account": {
                    "description": "The 12-digit account id.",
                    "pattern": "^[0-9]{12}$",
                    "type": "string"
                  },
                  "algs": {
                    "description": "Default both; narrow, never widen.",
                    "items": {
                      "enum": [
                        "ES384",
                        "RS256"
                      ]
                    },
                    "type": "array",
                    "uniqueItems": true
                  },
                  "issuer": {
                    "$ref": "#/$defs/url",
                    "description": "From `aws iam get-outbound-web-identity-federation-info`. https."
                  },
                  "jwksUri": {
                    "$ref": "#/$defs/url",
                    "description": "Default <issuer>/.well-known/jwks.json."
                  },
                  "name": {
                    "description": "The estate's word for it, for logs.",
                    "minLength": 1,
                    "type": "string"
                  },
                  "orgId": {
                    "description": "Require this AWS Organizations id.",
                    "minLength": 1,
                    "type": "string"
                  }
                },
                "required": [
                  "account",
                  "name",
                  "issuer"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "audience": {
              "description": "The audience the role must request. Required with an account: it is the trust boundary.",
              "minLength": 1,
              "type": "string"
            },
            "maxAge": {
              "$ref": "#/$defs/duration",
              "default": "5m",
              "description": "Refuse a token whose `iat` is older than this. At most 1h."
            }
          },
          "type": "object"
        },
        "clusters": {
          "description": "The clusters whose ServiceAccount tokens are verified, each against the key set it publishes for itself. This service's own cluster is a row like any other.",
          "items": {
            "additionalProperties": false,
            "description": "A cluster.",
            "properties": {
              "issuer": {
                "description": "The `iss` its ServiceAccount tokens carry.",
                "minLength": 1,
                "type": "string"
              },
              "jwksUri": {
                "$ref": "#/$defs/url",
                "description": "Where its keys are. Unset discovers them from the issuer."
              },
              "name": {
                "description": "The estate's word for it: the cluster in a `service_account` matcher. Renaming a row changes every rule about it.",
                "minLength": 1,
                "type": "string"
              }
            },
            "required": [
              "name",
              "issuer"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "github": {
          "additionalProperties": false,
          "description": "Whose GitHub Actions tokens are verified, for this issuer's URL as the audience.",
          "properties": {
            "owners": {
              "description": "The organisations. None verifies none: an empty list would admit every repository there is.",
              "items": {
                "minLength": 1,
                "type": "string"
              },
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    },
    "github": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "An organisation's bindings.",
        "properties": {
          "ignore": {
            "description": "Addresses and logins the controller leaves alone.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "members": {
            "description": "The groups whose holders belong in the organisation.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "teams": {
            "additionalProperties": {
              "additionalProperties": false,
              "description": "A team's binding.",
              "properties": {
                "maintainers": {
                  "description": "The groups whose holders are maintainers.",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                },
                "members": {
                  "description": "The groups whose holders are members.",
                  "items": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "type": "array"
                }
              },
              "type": "object"
            },
            "description": "Each team, by slug.",
            "type": "object"
          }
        },
        "type": "object"
      },
      "description": "GitHub organisations bound to internal groups, by login.",
      "type": "object"
    },
    "groups": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "A group.",
        "properties": {
          "matchers": {
            "description": "The matchers.",
            "items": {
              "additionalProperties": false,
              "description": "One way a caller comes to be in the group. Exactly one kind is set.",
              "properties": {
                "aws": {
                  "additionalProperties": false,
                  "description": "An IAM role in an account `exchange.aws` federates.",
                  "properties": {
                    "account": {
                      "description": "The 12-digit account id.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "function": {
                      "description": "A Lambda function's name.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "org_id": {
                      "description": "The AWS Organizations id.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "path": {
                      "description": "The role's path.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "role": {
                      "description": "The role's name, a glob.",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "account"
                  ],
                  "type": "object"
                },
                "email": {
                  "description": "One signed-in address.",
                  "minLength": 1,
                  "type": "string"
                },
                "email_domain": {
                  "description": "Every signed-in address in a domain.",
                  "minLength": 1,
                  "type": "string"
                },
                "github": {
                  "additionalProperties": false,
                  "description": "A GitHub Actions job, by what its verified token says.",
                  "properties": {
                    "environment": {
                      "description": "The deployment environment.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "event_name": {
                      "description": "The triggering event.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "job_workflow_ref": {
                      "description": "The reusable workflow at a ref, a glob.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "owner": {
                      "description": "The repository's owner.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "ref": {
                      "description": "The ref, a glob.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "ref_type": {
                      "description": "branch or tag.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "repository": {
                      "description": "owner/name, a glob.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "sha": {
                      "description": "The commit.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "visibility": {
                      "description": "public, private or internal.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "workflow": {
                      "description": "The workflow's name.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "workflow_ref": {
                      "description": "The workflow file at a ref, a glob.",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "type": "object"
                },
                "service_account": {
                  "additionalProperties": false,
                  "description": "A ServiceAccount on a federated cluster.",
                  "properties": {
                    "cluster": {
                      "description": "The cluster's name in `exchange.clusters`. Unset is the unqualified subject.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "name": {
                      "description": "The ServiceAccount.",
                      "minLength": 1,
                      "type": "string"
                    },
                    "namespace": {
                      "description": "The namespace.",
                      "minLength": 1,
                      "type": "string"
                    }
                  },
                  "required": [
                    "namespace",
                    "name"
                  ],
                  "type": "object"
                }
              },
              "type": "object"
            },
            "type": "array"
          },
          "members": {
            "description": "Directory groups whose members are in it.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          }
        },
        "type": "object"
      },
      "description": "Every internal group, by name, and how a caller comes to be in it.",
      "type": "object"
    },
    "lifetimes": {
      "additionalProperties": {
        "$ref": "#/$defs/duration",
        "description": "A lifetime."
      },
      "description": "How long a token lives, by group, and `default`. The shortest across a caller's groups wins.",
      "type": "object"
    },
    "people": {
      "additionalProperties": {
        "description": "The addresses.",
        "items": {
          "minLength": 1,
          "type": "string"
        },
        "type": "array"
      },
      "description": "Which addresses are one person, by a name the installation chooses.",
      "type": "object"
    },
    "resources": {
      "additionalProperties": {
        "additionalProperties": false,
        "description": "A resource a token may be minted for, when it is not the client asking.",
        "properties": {
          "absolute_cap": {
            "$ref": "#/$defs/duration",
            "description": "The longest a session that touched it lives."
          },
          "description": {
            "description": "One line about it.",
            "minLength": 1,
            "type": "string"
          },
          "display_name": {
            "description": "What the consent page calls it.",
            "minLength": 1,
            "type": "string"
          },
          "groups": {
            "description": "Which held groups beyond the requires pairs a token for it carries: `all`, or a list of things, families or names (docs/reference/policy.md#groups-in-a-token-scoping).",
            "oneOf": [
              {
                "const": "all"
              },
              {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "type": "array"
              }
            ]
          },
          "groups_delimiter": {
            "description": "Rewrites `:` in its `groups` claim.",
            "minLength": 1,
            "type": "string"
          },
          "read_only": {
            "description": "It only reads: an absolute cap past the installation's may be honoured. Deprecated as a lengthening (docs/decisions/0040): mark the clients `session: agent` instead; a lengthening row is warned about at start.",
            "type": "boolean"
          },
          "requires": {
            "description": "The groups a caller must hold, any of them.",
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "type": "array"
          },
          "signing_alg": {
