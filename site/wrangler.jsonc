// The Worker that serves sluis.id: static assets, and the live status API on /api/* (ADR 0020).
// Built by `astro build` with the Cloudflare adapter (SLUIS_TARGET=workers), which
// writes the configuration to deploy from this file (.wrangler/deploy/config.json points at it).
// The deploy job of .github/workflows/site.yaml runs `wrangler deploy` on it. The repository holds no account id, no
// namespace id and no Cloudflare hostname.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sluis-site",
  // The Worker's own code is src/worker/index.ts: the /api/* routes and the cron below.
  // The adapter drops `main` from the configuration of a fully prerendered site, so
  // src/cloudflare-worker-main.mjs adds it to the generated configuration; it is not here.
  // Compatibility date: not newer than two weeks before it was chosen.
  "compatibility_date": "2026-10-15",
  // BOTH OFF FOR GOOD (owner decision). Wrangler's defaults turn them on: every
  // deploy would publish a <worker>.<account-subdomain>.workers.dev hostname, and
  // previews would publish one per version. That hostname names the operator's
  // account, and pull requests are public. Pull requests are judged by GitHub CI and
  // by `wrangler dev`. Do not turn these on.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    // The adapter fills in the directory (dist/client). A page that does not exist
    // gets the site's own 404.html with status 404.
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only /api/* runs the Worker first. A request for anything else that is an asset is
    // served from the assets and never invokes the Worker: that keeps static traffic off
    // the Free plan's daily request limit (ADR 0020). Never widen this to "/*" or true,
    // and never turn on Workers Cache.
    "run_worker_first": ["/api/*"]
  },
  // The safety net for missed webhook deliveries (ADR 0020): every 15 minutes the Worker
  // reads the board and writes KV only when something changed (src/worker/status.ts).
  "triggers": { "crons": ["*/15 * * * *"] },
  "kv_namespaces": [
    // The live status documents, `board` and `ci` (ADR 0020, src/worker/status.ts). The id comes from the build variable
    // SLUIS_STATUS_KV_ID, a secret of the deploy environment (src/cloudflare-kv-id.mjs rewrites the generated
    // configuration); this placeholder is never deployed.
    { "binding": "STATUS", "id": "00000000000000000000000000000000" }
  ]
}
