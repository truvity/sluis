---
// The traceability of one record as small chips: standards (linked to the specification),
// features (parity or design), the issues that deliver it and the gap key.
import { catalogue, issueUrl, type Req } from '../../lib/requirements';

interface Props { req: Req; only?: 'standards' | 'features' | 'issues' | 'gap' }
const { req, only } = Astro.props;
const c = catalogue();
const show = (k: string) => !only || only === k;
---

{show('standards') && req.standards.map((s) => {
  const std = c.standardById.get(s.id);
  const label = s.section ? `${s.id} §${s.section}` : s.id;
  const title = `${std?.name ?? s.id}, depth ${s.depth}`;
  return std?.url
    ? <a class={`rq-chip rq-depth-${s.depth.toLowerCase()}`} href={std.url} title={title}>{label}</a>
    : <span class={`rq-chip rq-depth-${s.depth.toLowerCase()}`} title={title}>{label}</span>;
})}
{show('features') && req.features.map((f) => (
  <span class="rq-chip rq-feature" title={f === 'parity' ? 'Part of v1 parity; no single issue.' : 'Specified; no issue yet.'}>{f}</span>
))}
{show('issues') && (req.issues ?? []).map((n) => <a class="rq-chip rq-issue" href={issueUrl(n)} title={`Delivered by issue #${n}`}>#{n}</a>)}
{show('gap') && req.gap && <span class="rq-chip rq-gap" title={c.gaps[req.gap]}>{req.gap}</span>}
