---
// The order in which v2 is delivered, as a strip on the home page and "you are here" on the first.
// The names are the delivery milestones of the roadmap (docs/roadmap.md, "Delivery order"): the
// core, customer identity with the limit check, parity, and the PKI, SSH and database add-on.
// The class names ("phases") are those of home.css.
const milestones = [
  { name: 'Core', note: 'alpha.2', href: '/roadmap/#core', now: true },
  { name: 'Customer identity and quota', note: '', href: '/roadmap/#customer-identity-and-quota' },
  { name: 'Parity with v1', note: '', href: '/roadmap/#parity' },
  { name: 'PKI, SSH and database', note: 'add-on', href: '/roadmap/#the-pki-ssh-and-database-add-on' },
];
---

<nav class="phases" aria-label="The delivery order of v2">
  <ol>
    {milestones.map((p) => (
      <li class:list={[{ now: p.now }]} aria-current={p.now ? 'step' : undefined}>
        <a href={p.href}><b>{p.name}</b>{p.note && <span>{p.note}</span>}</a>
        {p.now && <em>being built</em>}
      </li>
    ))}
  </ol>
</nav>
