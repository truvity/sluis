---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { decisionTitle, listDecisions } from '../../lib-decisions';

const entries = await listDecisions();
---

<StarlightPage
  frontmatter={{
    title: 'Decisions',
    description:
      'The architecture decision records for sluis: what was decided, why, and which options were set aside. The index is built from docs/decisions.',
    status: 'shipped',
    badge: false,
  }}
>
  <p>
    Significant choices are recorded as architecture decision records (ADRs) in
    <a href="https://github.com/truvity/sluis/tree/main/docs/decisions"><code>docs/decisions/</code></a>
    in the repository. This index is built from that directory on every build.
  </p>
  {
    entries.length === 0 ? (
      <p>
        <em>No decision records have been published yet.</em>
      </p>
    ) : (
      <ul>
        {entries.map((entry) => (
          <li>
            <a href={`/decisions/${entry.id}/`}>{decisionTitle(entry)}</a>
            {entry.data.status && <span> ({entry.data.status})</span>}
          </li>
        ))}
      </ul>
    )
  }
</StarlightPage>
