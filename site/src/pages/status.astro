---
// The project status page (ADR 0020). Groups and their order come from the project's
// `Product milestone` field (src/lib/project.ts); requirement and decision facts from the
// repository. The data part (src/lib/status-html.ts) is drawn here from the board as read at
// build time, and the page's one script (src/scripts/status-live.ts) swaps in the same part
// drawn by the Worker from the live board, /api/status/live/. Without JavaScript, or when
// the Worker cannot answer, the snapshot stays, labelled with its time.
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { Aside, Badge } from '@astrojs/starlight/components';
import '../styles/project-status.css';
import { BUILT_AT } from '../lib/repo';
import { FIELD, ORG, PROJECT_NUMBER } from '../lib/project';
import { statusGroups } from '../lib/project-status';
import { statusBodyHtml } from '../lib/status-html';

const { board, groups } = await statusGroups();
const asOf = BUILT_AT.replace('T', ' ').replace(/:\d{2}Z$/, ' UTC');
const boardUrl = `https://github.com/orgs/${ORG}/projects/${PROJECT_NUMBER}`;
const ADR = '/decisions/0020-the-site-is-static-on-cloudflare-workers/';
---

<StarlightPage
  frontmatter={{
    title: 'Project status',
    description:
      'Where sluis v2 stands, by product milestone: requirements, decision records and live issue figures per milestone and area.',
    status: 'shipped',
    badge: false,
    tableOfContents: false,
  }}
>
  <div class="ps" data-project={board.available ? 'available' : 'unavailable'} data-options={board.available ? board.options.length : 0}>
    <p>
      The work on sluis v2, grouped by the <code>{FIELD}</code> field of the <a href={boardUrl}>project board</a>, in the field's
      order. Each requirement sits under the milestone of the issues that deliver it, and each decision record under the milestone of
      its proposal issue. <a href="#how-this-page-is-built">How this page is built</a> is at the end.
    </p>
    <p class="ps-legend">
      <Badge text="build-time" variant="note" /> from the repository, as of the build at {asOf}.{' '}
      <Badge text="live" variant="tip" /> read from the board and CI by the site's Worker, kept current by GitHub webhooks and a check
      every 15 minutes; each block says the time its data is as of. Without JavaScript the page shows the snapshot taken at the build.
    </p>

    {
      !board.available && (
        <Aside type="caution" title="Project data not available at build time">
          This build could not read the project board ({board.reason}), so every requirement and decision record is listed under
          "{groups[0].name}" and the issue columns show "—". A build with a token that can read the organisation's project fills them in.
        </Aside>
      )
    }

    <div class="ps-live" data-live-src="/api/status/live/">
      <p class="ps-live-note" data-live-note hidden>
        The live data could not be read just now, so this is the build-time snapshot as of {asOf}.
      </p>
      <div data-live-body>
        <Fragment set:html={statusBodyHtml({ groups, mode: 'snapshot', asOf: BUILT_AT, available: board.available })} />
      </div>
    </div>

    <h2 id="how-this-page-is-built">How this page is built</h2>
    <p>
      The page is built with the site, as decided in <a href={ADR}>ADR 0020</a>. The groups and their order are the options of the
      project's <code>{FIELD}</code> field, read from GitHub during the build and again by the live block; adding or reordering an option
      changes the page with no code change. Requirement and decision status come from the repository (<code>docs/requirements/</code> and <code>docs/decisions/</code>)
      and are published as <a href="/data/repo.json"><code>/data/repo.json</code></a>. A requirement is <code>done</code> only when a pull request set it together with the passing test. A requirement is placed under the earliest
      milestone of the issues it links, a decision record under the milestone of its proposal issue, and the current milestone is the
      first one that still has open issues. The build places them with the board as it was then; the live block places them with the
      board as it is now. The live data comes from the site's status API, <a href="https://sluis.id/api/status"><code>/api/status</code></a>: GitHub
      webhooks and a check every 15 minutes keep it current, and CI runs on <code>main</code> post coverage and conformance to it.
    </p>
  </div>
</StarlightPage>

<script>
  import '../scripts/status-live.ts';
</script>
