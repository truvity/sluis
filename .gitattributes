# Normalise line endings: text files are stored with LF.
* text=auto eol=lf

# Scripts must keep LF even on Windows checkouts.
*.sh text eol=lf

# Binary assets live in Git LFS.
# Keep LFS to documentation and site assets: Go module downloads do not
# resolve LFS objects, so nothing that code embeds or ships may be in LFS.
# The Site workflow must check out with `lfs: true`.
*.png  filter=lfs diff=lfs merge=lfs -text
*.jpg  filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif  filter=lfs diff=lfs merge=lfs -text
*.webp filter=lfs diff=lfs merge=lfs -text
*.ico  filter=lfs diff=lfs merge=lfs -text
*.pdf  filter=lfs diff=lfs merge=lfs -text
*.mp4  filter=lfs diff=lfs merge=lfs -text
*.webm filter=lfs diff=lfs merge=lfs -text
*.woff  filter=lfs diff=lfs merge=lfs -text
*.woff2 filter=lfs diff=lfs merge=lfs -text
*.ttf   filter=lfs diff=lfs merge=lfs -text
*.otf   filter=lfs diff=lfs merge=lfs -text

# Text formats that stay in git and diff normally.
*.svg  text
*.md   text
*.yaml text
*.json text
*.dsl  text

# Generated files: collapsed in GitHub diffs.
docs/reference/generated/** linguist-generated=true
**/*.pb.go                  linguist-generated=true
**/gen/**                   linguist-generated=true
