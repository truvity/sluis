{
  "uid": "sluis-lambda",
  "title": "sluis Lambda - $cluster",
  "description": "The Lambda functions' starts: cold starts, init duration, and inits that ran into the 10 second limit or failed, read from the platform's INIT_REPORT events in the log store.",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "",
  "annotations": {
    "list": []
  },
  "links": [],
  "tags": [
    "sluis",
    "lambda"
  ],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "datasource",
        "type": "datasource",
        "query": "victoriametrics-logs-datasource",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false
      },
      {
        "name": "cluster",
        "label": "cluster",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "type": "fieldValue",
          "field": "k8s.cluster.name",
          "query": "event.name:\"platform.initReport\"",
          "limit": 100
        },
        "definition": "field values of k8s.cluster.name",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      },
      {
        "name": "function",
        "label": "function",
        "type": "query",
        "datasource": {
          "type": "victoriametrics-logs-datasource",
          "uid": "${datasource}"
        },
        "query": {
          "type": "fieldValue",
          "field": "faas.name",
          "query": "event.name:\"platform.initReport\" k8s.cluster.name:\"$cluster\"",
          "limit": 100
        },
        "definition": "field values of faas.name",
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "hide": 0,
        "includeAll": true,
        "allValue": "*",
        "multi": false,
        "options": [],
        "refresh": 2,
        "regex": "",
        "skipUrlSync": false,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Is anything failing to start?",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Init timeouts (range)",
      "description": "Inits that ran into the Lambda init limit in the range (INIT_REPORT with status timeout). Lambda gives a function's init phase 10 seconds; a longer one is cut off and reported with status timeout, and Lambda then initialises again inside the first invocation. One is a bad cold start; repeats are a dependency that is slow to answer during init (the configuration, a secret, a store) or a function whose init grew past the limit. See the telemetry runbook.",
      "datasource": {
        "type": "victoriametrics-logs-datasource",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "0",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 3
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "victoriametrics-logs-datasource",
            "uid": "${datasource}"
          },
          "expr": "event.name:\"platform.initReport\" k8s.cluster.name:\"$cluster\" faas.name:$function status:timeout | stats count() as n",
          "queryType": "stats",
          "editorMode": "code"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Other init failures (range)",
      "description": "Inits that ended with a status other than success or timeout (INIT_REPORT with status error or failure): the function crashed or refused to start. The function's log has the reason.",
