{
  "name": "@truvity/sluis",
  "version": "0.0.0",
  "description": "What a console needs from the identity it is behind: who the caller is, what that gets them, and the way out. Published to GitHub Packages at each release tag's version; see docs/reference/typescript.md.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/truvity/sluis.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./ts/dist/index.js",
  "types": "./ts/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./ts/dist/index.d.ts",
      "import": "./ts/dist/index.js"
    },
    "./react": {
      "types": "./ts/dist/react/index.d.ts",
      "import": "./ts/dist/react/index.js"
    },
    "./server": {
      "types": "./ts/dist/server/index.d.ts",
      "import": "./ts/dist/server/index.js"
    }
  },
  "files": [
    "ts/dist/**"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "dependencies": {
    "jose": "^6.2.12"
  },
  "peerDependencies": {
    "react": ">=18",
    "@mui/material": ">=6"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "@mui/material": {
      "optional": true
    }
  }
}
