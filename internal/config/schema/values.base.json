  "definitions": {
    "privateKey": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "enum": [
            "RSA",
            "ECDSA"
          ]
        },
        "size": {
          "type": "integer",
          "enum": [
            256,
            384,
            521,
            2048,
            3072,
            4096
          ]
        },
        "encoding": {
          "enum": [
            "PKCS1",
            "PKCS8"
          ]
        },
        "rotationPolicy": {
          "enum": [
            "Never",
            "Always"
          ]
        }
      }
    },
    "duration": {
      "type": "string",
      "pattern": "^[0-9]+(ns|us|\u00b5s|ms|s|m|h)([0-9]+(ns|us|\u00b5s|ms|s|m|h))*$"
    },
    "secretEnv": {
      "type": "array",
      "description": "Environment variables from a Secret's keys: the holders of the secrets the config names (`valkey.passwordEnv`, `oauthClient.secretEnv`, `adminPasswordEnv`). A secret is never in `config`.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "secretName",
          "key"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "description": "The variable, as the config names it."
          },
          "secretName": {
            "type": "string",
            "minLength": 1,
            "description": "The Secret."
          },
          "key": {
            "type": "string",
            "minLength": 1,
            "description": "The key in the Secret."
          },
          "optional": {
            "type": "boolean",
            "description": "Start without it when the Secret or the key is absent."
          }
        }
      }
    },
    "secretMounts": {
      "type": "array",
      "description": "Secrets mounted read-only as directories, for a file the config names by path (`oauthClient.idFile`, `oauthClient.secretFile`). Each key is a file.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "secretName",
          "mountPath"
        ],
        "properties": {
          "secretName": {
            "type": "string",
            "minLength": 1,
            "description": "The Secret."
          },
          "mountPath": {
            "type": "string",
            "minLength": 1,
            "description": "The directory it appears in."
          }
        }
      }
    }
  }
